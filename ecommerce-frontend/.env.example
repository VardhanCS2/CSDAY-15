# FastAPI URL used by the Vite development server proxy.
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional absolute API base URL for a deployed frontend. Leave unset to use /api.
# VITE_API_BASE_URL=

# Optional public API documentation URL. Defaults to the same-origin API proxy.
# VITE_API_DOCS_URL=/api/docs

# Optional public storefront formatting preferences.
# VITE_LOCALE=en-IN
# VITE_CURRENCY=INR
